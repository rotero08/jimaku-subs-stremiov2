{
  "name": "jimaku-subs-stremio",
  "version": "3.0.0",
  "description": "Stremio addon that finds Japanese subtitles on Jimaku.cc for anime and Japanese media, and converts ASS to SRT on the fly.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "jimaku-subs-stremio": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "publish-to-stremio": "node scripts/publish-to-stremio.js"
  },
  "keywords": [
    "stremio",
    "stremio-addon",
    "subtitles",
    "jimaku",
    "anime",
    "japanese"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0"
  }
}
